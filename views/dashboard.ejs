<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🏗 Construction Dashboard</h2>
        <div>
            <a href="/addProject" class="btn btn-primary">+ Add Project</a>
            <a href="/logout" class="btn btn-danger">Logout</a>
        </div>
    </div>

    <table class="table table-bordered table-hover bg-white shadow">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Location</th>
                <th>Budget</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            <% data.forEach(p => { %>
            <tr>
                <td><%= p.pname %></td>
                <td><%= p.location %></td>
                <td>₹ <%= p.budget %></td>
                <td>
                    <span class="badge bg-info text-dark">
                        <%= p.status %>
                    </span>
                </td>
                <td>
                    <a href="/edit/<%= p.id %>" class="btn btn-warning btn-sm">Edit</a>

                    <form action="/delete/<%= p.id %>?_method=delete" method="post" class="d-inline">
                        <button class="btn btn-danger btn-sm"
                            onclick="return confirm('Are you sure?')">
                            Delete
                        </button>
                    </form>

                    <a href="/expenses/<%= p.id %>" class="btn btn-success btn-sm">
                        Expenses
                    </a>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>

</div>

</body>
</html>
